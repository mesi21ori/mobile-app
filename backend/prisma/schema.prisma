generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum AssetType {
  RETURNABLE
  CONSUMABLE
}

enum AssetCondition {
  INTACT
  DAMAGED
  LOST
}

enum FinanceType {
  INCOME
  EXPENSE
}

enum AuditPeriod {
  THREE_MONTHS
  SIX_MONTHS
}

enum AuditStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

model User {
  id           Int      @id @default(autoincrement())
  fullName     String   @map("full_name")
  username     String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)
  memberId     Int?     @unique @map("member_id")
  member       Member?  @relation(fields: [memberId], references: [id])
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  financeEntries Finance[]
  auditsCreated  AssetAudit[] @relation("AuditedBy")
  auditsApproved AssetAudit[] @relation("ApprovedBy")

  @@map("users")
}

model Department {
  id     Int     @id @default(autoincrement())
  name   String  @map("department_name")
  head   String? @map("head_name")
  members Member[]
  assets  Asset[]
  assetLoans AssetLoan[]
  audits  AssetAudit[]

  @@map("departments")
}

model Member {
  id           Int         @id @default(autoincrement())
  fullName     String      @map("full_name")
  phoneNumber  String?     @map("phone_number")
  departmentId Int?        @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])
  user         User?
  groupMembers GroupMember[]
  vestmentLoans VestmentLoan[]
  assetLoans   AssetLoan[]

  @@map("members")
}

model Vestment {
  id                 Int             @id @default(autoincrement())
  name               String          @map("vestment_name")
  totalQuantity      Int             @default(0) @map("total_quantity")
  availableQuantity  Int             @default(0) @map("available_quantity")
  issuedQuantity     Int             @default(0) @map("issued_quantity")
  dirtyQuantity      Int             @default(0) @map("dirty_quantity")
  loans              VestmentLoan[]

  @@map("vestments")
}

model Event {
  id        Int      @id @default(autoincrement())
  name      String   @map("event_name")
  issueDate DateTime @map("issue_date") @db.Date
  dueDate   DateTime @map("due_date") @db.Date
  loans     VestmentLoan[]
  finance   Finance[]

  @@map("events")
}

model Group {
  id      Int           @id @default(autoincrement())
  name    String        @map("group_name")
  members GroupMember[]
  loans   VestmentLoan[]

  @@map("groups")
}

model GroupMember {
  groupId  Int    @map("group_id")
  memberId Int    @map("member_id")
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([groupId, memberId])
  @@map("group_members")
}

model VestmentLoan {
  id            Int       @id @default(autoincrement())
  eventId       Int       @map("event_id")
  groupId       Int       @map("group_id")
  memberId      Int       @map("member_id")
  vestmentId    Int       @map("vestment_id")
  issueDate     DateTime  @map("issue_date") @db.Date
  dueDate       DateTime  @map("due_date") @db.Date
  returnedDate  DateTime? @map("returned_date") @db.Date
  isReturned    Boolean   @default(false) @map("is_returned")
  isDirty       Boolean   @default(false) @map("is_dirty")
  isWashed      Boolean   @default(false) @map("is_washed")
  penaltyAmount Decimal   @default(0) @map("penalty_amount") @db.Decimal(10, 2)

  event    Event    @relation(fields: [eventId], references: [id])
  group    Group    @relation(fields: [groupId], references: [id])
  member   Member   @relation(fields: [memberId], references: [id])
  vestment Vestment @relation(fields: [vestmentId], references: [id])

  @@map("vestment_loans")
}

model Asset {
  id                 Int       @id @default(autoincrement())
  name               String    @map("asset_name")
  type               AssetType @map("asset_type")
  departmentId       Int?      @map("department_id")
  department         Department? @relation(fields: [departmentId], references: [id])
  totalQuantity      Int       @default(0) @map("total_quantity")
  availableQuantity  Int       @default(0) @map("available_quantity")
  issuedQuantity     Int       @default(0) @map("issued_quantity")
  damagedQuantity    Int       @default(0) @map("damaged_quantity")
  lostQuantity       Int       @default(0) @map("lost_quantity")
  loans              AssetLoan[]
  auditDetails       AuditDetail[]

  @@map("assets")
}

model AssetLoan {
  id            Int             @id @default(autoincrement())
  assetId       Int             @map("asset_id")
  departmentId  Int?            @map("department_id")
  memberId      Int?            @map("member_id")
  quantity      Int
  issuedDate    DateTime        @default(now()) @map("issued_date") @db.Date
  returnedDate  DateTime?       @map("returned_date") @db.Date
  isReturned    Boolean         @default(false) @map("is_returned")
  condition     AssetCondition? @map("return_condition")
  returnedIntact  Int           @default(0) @map("returned_intact")
  returnedDamaged Int           @default(0) @map("returned_damaged")
  returnedLost    Int           @default(0) @map("returned_lost")

  asset      Asset       @relation(fields: [assetId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  member     Member?     @relation(fields: [memberId], references: [id])

  @@map("asset_loans")
}

model Finance {
  id        Int         @id @default(autoincrement())
  eventId   Int?        @map("event_id")
  event     Event?      @relation(fields: [eventId], references: [id])
  type      FinanceType
  reason    String
  amount    Decimal     @db.Decimal(12, 2)
  createdAt DateTime    @default(now()) @map("created_at")
  createdById Int?      @map("created_by")
  createdBy User?       @relation(fields: [createdById], references: [id])

  @@map("finance")
}

model AssetAudit {
  id          Int         @id @default(autoincrement())
  departmentId Int        @map("department_id")
  department  Department  @relation(fields: [departmentId], references: [id])
  auditedById Int         @map("audited_by")
  auditedBy   User        @relation("AuditedBy", fields: [auditedById], references: [id])
  approvedById Int?       @map("approved_by")
  approvedBy  User?       @relation("ApprovedBy", fields: [approvedById], references: [id])
  period      AuditPeriod @map("audit_period")
  status      AuditStatus @default(DRAFT)
  auditDate   DateTime    @default(now()) @map("audit_date") @db.Date
  lastCountedLoanId Int?  @map("last_counted_loan_id")
  details     AuditDetail[]

  @@map("asset_audits")
}

model AuditDetail {
  id                Int        @id @default(autoincrement())
  auditId           Int        @map("audit_id")
  audit             AssetAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  assetId           Int        @map("asset_id")
  asset             Asset      @relation(fields: [assetId], references: [id])
  systemQuantity    Int        @map("system_quantity")
  physicalQuantity  Int        @map("physical_quantity")
  discrepancy       Int
  remarks           String?

  @@map("audit_details")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}
